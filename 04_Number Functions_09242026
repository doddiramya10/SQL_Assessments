-- ## 13. Aggregate Numeric Functions

-- SUM, AVG, MIN and MAX summarize numeric data.
select department_id ,sum(salary) as total_salary,avg(salary) as average_Salary,min(salary) as minimum_salary,max(salary) as maximum_salary from hr.employees group by DEPARTMENT_ID ORDER by DEPARTMENT_ID
















